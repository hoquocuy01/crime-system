# Sao chép file này thành .env và điền thông tin thật của máy bạn.
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=THAY_BANG_MAT_KHAU_DATABASE_RIENG
DB_NAME=crime_db
DB_CONNECTION_LIMIT=10
# Để trống nếu chỉ dùng cùng origin (http://localhost:3000). Nếu cần frontend khác origin,
# liệt kê origin chính xác, phân tách bằng dấu phẩy; không dùng *.
CORS_ORIGINS=
# Tạo chuỗi bí mật ngẫu nhiên >= 32 ký tự, ví dụ bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=THAY_BANG_CHUOI_NGAU_NHIEN_DAI_IT_NHAT_32_KY_TU
